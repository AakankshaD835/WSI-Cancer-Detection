# Copy this file to .env and fill in your keys
# Only ONE of these is needed — free options listed first

# FREE - Groq (Llama 3.1 70B) — recommended — sign up at console.groq.com
GROQ_API_KEY=gsk_...

# FREE - Google Gemini Flash — sign up at aistudio.google.com
GEMINI_API_KEY=AI...

# FREE - HuggingFace (Mixtral) — sign up at huggingface.co
HF_API_KEY=hf_...

# PAID - Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# PAID - OpenAI GPT
OPENAI_API_KEY=sk-...
